{
  "cases": [
    {
      "case_id": "kbcli-script-sage-correct",
      "name": "剧本专家问答 - 正确路径（sage 分支）",
      "input": {
        "user_message": "@剧本专家，proj_id:OPIID-320c744c41ed,scriptAnalysisId:SVID-04490235b951-tv3g,scriptVersionId:SVID-04490235b951，为这个剧本写一篇约1000字的故事摘要。要求如下：1、段落连贯，不分点；2、首句点出故事背景与核心冲突；3、故事结构按起承转合梳理但不出现'起''承转''合'字样；4、人物塑造血肉丰满。"
      },
      "expected": {
        "path_id": "path_kbcli",
        "expected_skills": [
          { "name": "kbcli", "required": true }
        ],
        "nodes": [
          "match_intent",
          "read_references",
          "decision_main",
          "node_sage",
          "output_sage",
          "path_kbcli"
        ],
        "node_specs": [
          { "id": "match_intent",   "kind": "input",      "required": true, "tool": "" },
          { "id": "read_references","kind": "validation", "required": true, "tool": "read_file" },
          { "id": "decision_main",  "kind": "decision",   "required": true, "tool": "" },
          { "id": "node_sage",      "kind": "tool",       "required": true, "tool": "kbcli sage" },
          { "id": "output_sage",    "kind": "output",     "required": true, "tool": "" }
        ],
        "execution_chain": [
          { "id": "node_sage", "kind": "tool", "tool": "kbcli sage", "required": true }
        ],
        "notices": [
          "禁止跳过references凭记忆拼接命令",
          "不得输出proj_id/scriptAnalysisId/scriptVersionId字段名或值"
        ],
        "output_spec": {
          "type": "专家回答",
          "contains": ["剧本", "故事"],
          "not_contain": ["proj_id:", "scriptAnalysisId:", "scriptVersionId:"]
        },
        "forbidden_nodes": [
          "node_recall",
          "node_sql_mode",
          "node_dsl_mode",
          "node_mcp_fallback"
        ]
      }
    },
